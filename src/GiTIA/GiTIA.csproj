<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <!-- TIA Portal and Openness are 64-bit only. -->
    <PlatformTarget>x64</PlatformTarget>
    <TiaPublicApi>$(ProgramW6432)\Siemens\Automation\Portal V21\PublicAPI\V21\net48</TiaPublicApi>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core is compiled into the exe so GiTIA.exe runs on its own; the Core project stays for the tests. -->
    <Compile Include="..\GiTIA.Core\*.cs" />
    <Reference Include="System.Design" />
    <Reference Include="Microsoft.VisualBasic" />
    <!-- Loaded from the TIA install at runtime (Tia.RegisterAssemblyResolver), never copied. -->
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(TiaPublicApi)\Siemens.Engineering.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
